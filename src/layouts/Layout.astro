---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { getCurrentLanguage } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  showLanguageSwitcher?: boolean;
}

const currentLocale = getCurrentLanguage(Astro.url.pathname);
const {
  title = currentLocale === 'en' ? 'Aflujo - Work with your PDFs' : 'Aflujo - Trabaja con tus PDFs',
  description = currentLocale === 'en' ? 'Convert, split and combine your PDFs with Aflujo.' : 'Convierte, divide y combina tus PDFs con Aflujo.',
  showLanguageSwitcher = true,
} = Astro.props;
---

<!doctype html>
<html lang={currentLocale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/images/logo2.png" />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		{showLanguageSwitcher && <LanguageSwitcher />}
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	:global(body) {
		background: rgb(28, 28, 30);
		color: rgba(255, 255, 255, 0.98);
		font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
		--init-background-color: rgb(28, 28, 30);
		--init-label-color: rgba(255, 255, 255, 0.98);
		--secondary-color: rgba(255, 255, 255, 0.6);
	}
</style>
