---

const logo2Path = '/images/logo2.png';
const actualPath = '/actual.mp4';
---

<div id="container">
    <nav>
        <div class="logo">
            <img src={logo2Path} alt="Aflujo Logo" class="nav-logo">
            <span>Aflujo</span>
        </div>
    </nav>

    <main>
        <h1>
            <img src={logo2Path} alt="Aflujo Logo" class="main-logo">
            Aflujo
        </h1>
        <p>Una aplicación para trabajar con tus pdfs. Convierte tus PDFs en texto, imagenes, divide y combina.</p>
        
        <div class="video-container">
            <video src={actualPath} autoplay loop muted playsinline class="demo-image">
                Tu navegador no soporta el elemento de video.
            </video>
        </div>
    </main>

    <footer><a href="https://github.com/fedebarco/PDFtoText/tree/main">GitHub</a></footer>
</div>

<style>
:root {
    --init-background-color: rgb(28, 28, 30);
    --init-label-color: rgba(255, 255, 255, 0.98);
    --secondary-color: rgba(255, 255, 255, 0.6);
}

body {
    background-color: var(--init-background-color);
    color: var(--init-label-color);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", sans-serif;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    letter-spacing: -0.022em;
}

nav {
    background-color: rgba(28, 28, 30, 0.8);
    padding: 16px 40px;
    width: 100%;
    text-align: left;
    box-sizing: border-box;
    backdrop-filter: blur(20px);
    position: fixed;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.logo {
    font-size: 1.2em;
    font-weight: 600;
    color: var(--init-label-color);
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo span {
    color: white;
}

.nav-logo {
    width: 28px;
    height: 28px;
    object-fit: contain;
}

main {
    text-align: center;
    padding: 120px 20px 40px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 980px;
    margin: 0 auto;
}

main h1 {
    font-size: 56px;
    margin: 0 0 20px;
    font-weight: 500;
    letter-spacing: -0.05em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
}

.main-logo {
    width: 72px;
    height: 72px;
    object-fit: contain;
}

main p {
    font-size: 21px;
    margin-bottom: 40px;
    color: var(--init-label-color);
    line-height: 1.47059;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
}

.video-container {
    margin-bottom: 40px;
    width: 100%;
    max-width: 640px;
}

.demo-image {
    width: 100%;
    border-radius: 18px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
}

footer {
    width: 100%;
    text-align: center;
    padding: 20px;
    box-sizing: border-box;
}

footer a {
    color: var(--secondary-color);
    text-decoration: none;
    margin: 0 10px;
    font-size: 12px;
    transition: color 0.2s ease;
}

footer a:hover {
    color: var(--init-label-color);
}

@media (max-width: 768px) {
    main h1 {
        font-size: 36px;
        flex-wrap: wrap;
    }
}
</style>
