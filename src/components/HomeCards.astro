---
import { getCurrentLanguage } from '../utils/i18n';

const lang = getCurrentLanguage(Astro.url.pathname);
const artwork = '/images/inicio-talleres.png';
// Panel bounds in the supplied 1672 × 941 banner. Each link owns its artwork
// viewport, so the same panels can stack independently on narrow screens.
const cards = [
  { title: 'Taller de Alejo', href: 'https://taller.aflujo.com', x: 44, width: 500 },
  { title: 'Moldes', href: 'https://moldes.aflujo.com', x: 574, width: 520 },
  { title: 'Software', href: lang === 'en' ? '/en/pdf' : '/pdf', x: 1126, width: 504 },
];
---

<main aria-label={lang === 'en' ? 'Aflujo projects' : 'Proyectos de Aflujo'}>
  <div class="cards">
    <img class="backdrop" src={artwork} alt="" width="1672" height="941" fetchpriority="high" aria-hidden="true" />
    {cards.map(card => (
      <a
        class="card"
        href={card.href}
        aria-label={card.title}
        style={`--left: ${card.x / 1672 * 100}%; --width: ${card.width / 1672 * 100}%; --ratio: ${card.width} / 555;`}
      >
        <svg viewBox={`${card.x} 172 ${card.width} 555`} aria-hidden="true" focusable="false">
          <image href={artwork} width="1672" height="941" />
        </svg>
      </a>
    ))}
  </div>
</main>

<style>
  :global(body:has(.cards)) {
    background: #2b1d17;
    color: #ffe2c4;
  }

  main {
    min-height: 100svh;
    display: grid;
    align-items: center;
    background: radial-gradient(ellipse at center, #352219, #241a16);
  }

  .cards {
    position: relative;
    width: 100%;
    aspect-ratio: 1672 / 941;
  }

  .backdrop {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card {
    position: absolute;
    top: 18.278427%;
    left: var(--left);
    width: var(--width);
    aspect-ratio: var(--ratio);
    display: block;
    border-radius: clamp(16px, 1.9vw, 32px);
    overflow: hidden;
    transition: filter 180ms ease, box-shadow 180ms ease;
  }

  .card svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card:hover {
    filter: brightness(1.12);
    box-shadow: 0 0 28px rgb(232 119 57 / 18%);
  }

  .card:focus-visible {
    outline: 3px solid #ffd6a8;
    outline-offset: 5px;
    filter: brightness(1.12);
  }

  @media (max-width: 767px) {
    main {
      padding: 28px 20px;
      box-sizing: border-box;
      background:
        radial-gradient(ellipse at top left, rgb(164 73 39 / 24%), transparent 45%),
        radial-gradient(ellipse at bottom right, rgb(164 73 39 / 20%), transparent 45%),
        #2b1d17;
    }

    .cards {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
      max-width: 460px;
      margin-inline: auto;
      aspect-ratio: auto;
    }

    .backdrop { display: none; }

    .card {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      border-radius: 22px;
      box-shadow: 0 14px 30px rgb(0 0 0 / 22%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card { transition: none; }
  }
</style>